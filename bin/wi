#!/usr/bin/env bash
# Work-item tracker helper: list [state] | next [--auto] | inbox | nextid <E<n>> <F|B> | index | validate | stale [days]
# Portable (bash 3.2 + awk): items are read from frontmatter; INDEX.md and design item tables are generated.
set -euo pipefail

STATES="backlog refined in-progress in-review completed"
OPEN_STATES="backlog refined in-progress in-review"

tracker_root() {
  if [[ -n "${WI_ROOT:-}" ]]; then echo "$WI_ROOT"
  elif [[ -f work-items/EPICS.md ]]; then echo work-items
  elif [[ -f EPICS.md && -d backlog ]]; then echo .
  else echo "no tracker: set WI_ROOT, or run '/work-items:wi init'" >&2; exit 1
  fi
}

ROOT="$(tracker_root)"
cd "$ROOT"

# One tab-separated record per item: state id epic type priority size status deps title file design last_reviewed auto
records() {
  local s f
  for s in $STATES; do
    for f in "$s"/*.md; do
      [[ -e "$f" ]] || continue
      awk -v state="$s" -v file="$f" '
        /^---$/ { n++; if (n == 2) exit; next }
        n == 1 { k = $0; sub(/:.*/, "", k); v = $0; sub(/^[^:]*:[ ]*/, "", v); sub(/[ \t]+#.*/, "", v); fm[k] = v }
        END {
          if (fm["id"] == "") exit
          e = fm["epic"]; sub(/ .*/, "", e)
          d = fm["depends_on"]; gsub(/[][ ]/, "", d)
          printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", state, fm["id"], e, fm["type"], fm["priority"], fm["size"], fm["status"], d, fm["title"], file, fm["design"], fm["last_reviewed"], fm["auto"]
        }' "$f"
    done
  done
}

epic_focus() { # "E<n> now|later" lines from EPICS.md
  awk '/^## E[0-9]+ / { e = $2 } e && /^focus:/ { print e, $2 }' EPICS.md
}

cmd_list() {
  local want="${1:-}"
  records | awk -F'\t' -v want="$want" '
    want == "" || $1 == want { printf "%-11s %-8s %-3s %-2s %-3s %-10s %s\n", $1, $2, $5, $4, $6, $7, $9 }'
}

# Pick-up ladder: deps done → epic focus → priority → unblock weight → bug first → smaller → ID.
cmd_next() { # [--auto]: prefix rows with build|refine|draft, skip auto: no
  { epic_focus | sed 's/^/F\t/; s/ /\t/'; records | sed 's/^/R\t/'; } | awk -F'\t' -v open="$OPEN_STATES" -v auto="${1:-}" '
    BEGIN { split(open, o, " "); for (i in o) isopen[o[i]] = 1 }
    $1 == "F" { focus[$2] = $3; next }
    { st[$3] = $2; ep[$3] = $4; ty[$3] = $5; pr[$3] = $6; sz[$3] = $7; status[$3] = $8; deps[$3] = $9; ti[$3] = $10; au[$3] = $14 }
    END {
      for (id in st) if (isopen[st[id]]) { n = split(deps[id], d, ","); for (i = 1; i <= n; i++) fanin[d[i]]++ }
      split("XS S M L XL XXL", sizes, " "); for (i in sizes) srank[sizes[i]] = i
      for (id in st) {
        if (st[id] != "backlog" && st[id] != "refined") continue
        if (status[id] == "blocked" || status[id] == "dropped" || status[id] == "draft") continue
        if (auto != "" && au[id] == "no") continue
        ready = 1; n = split(deps[id], d, ",")
        for (i = 1; i <= n; i++) if (d[i] != "" && (st[d[i]] != "completed" || status[d[i]] == "dropped")) ready = 0
        if (!ready) continue
        f = (focus[ep[id]] == "now") ? 0 : ((focus[ep[id]] == "later") ? 2 : 1)
        p = (pr[id] == "") ? "P3" : pr[id]
        s = (sz[id] in srank) ? srank[sz[id]] : 3
        match(id, /[0-9]+/); en = substr(id, RSTART, RLENGTH)
        rest = substr(id, RSTART + RLENGTH); match(rest, /[0-9]+/); mn = substr(rest, RSTART, RLENGTH)
        act = ""
        if (auto != "") act = (st[id] == "refined") ? "build   " : ((s <= 2) ? "refine  " : "draft   ")
        printf "%d%s%03d%d%d%04d%04d\t%s%-8s %-8s %-3s %-2s %-3s %s\n", f, p, 999 - fanin[id], ((ty[id] == "B") ? 0 : 1), s, en, mn, act, id, st[id], p, ty[id], sz[id], ti[id]
      }
    }' | sort | cut -f2-
}

# Items waiting on a human, TSV: kind id state holds title file. Sorted by holds desc, then ID.
inbox_rows() {
  records | awk -F'\t' -v open="$OPEN_STATES" '
    BEGIN { split(open, o, " "); for (i in o) isopen[o[i]] = 1 }
    function count_holds(id,   n, i, c, k) {
      seen[id] = 1; c = 0; n = split(dependents[id], k, ",")
      for (i = 1; i <= n; i++) if (k[i] != "" && !(k[i] in seen) && isopen[st[k[i]]]) c += 1 + count_holds(k[i])
      return c
    }
    { st[$2] = $1; ti[$2] = $9; fl[$2] = $10; status[$2] = $7; au[$2] = $13; ids[++n] = $2
      m = split($8, d, ","); for (i = 1; i <= m; i++) if (d[i] != "") dependents[d[i]] = dependents[d[i]] "," $2 }
    END {
      for (j = 1; j <= n; j++) {
        id = ids[j]; kind = ""
        if (status[id] == "blocked") kind = "decision"
        else if (status[id] == "needs-attention") kind = "failed"
        else if (status[id] == "draft") kind = "approve"
        else if (st[id] == "backlog" && au[id] == "no") kind = "refine"
        if (kind == "") continue
        delete seen; h = count_holds(id)
        match(id, /[0-9]+/); en = substr(id, RSTART, RLENGTH)
        rest = substr(id, RSTART + RLENGTH); match(rest, /[0-9]+/); mn = substr(rest, RSTART, RLENGTH)
        printf "%03d%04d%04d\t%s\t%s\t%s\t%d\t%s\t%s\n", 999 - h, en, mn, kind, id, st[id], h, ti[id], fl[id]
      }
    }' | sort | cut -f2-
}

cmd_inbox() { inbox_rows | awk -F'\t' '{ printf "%s %s %s holds=%d %s\n", $1, $2, $3, $4, $5 }'; }

gen_needs_you() {
  echo '## Needs you'; echo
  if [[ -z "$(inbox_rows)" ]]; then echo 'Nothing.'; return; fi
  echo '| Kind | Item | Holds | Title |'; echo '|---|---|---|---|'
  inbox_rows | awk -F'\t' '{ printf "| %s | [%s](%s) | %d | %s |\n", $1, $2, $6, $4, $5 }'
}

cmd_nextid() { # E<n> F|B
  local epic="${1:?usage: nextid E<n> F|B}" type="${2:?usage: nextid E<n> F|B}"
  records | awk -F'\t' -v pre="$epic-$type" '
    index($2, pre) == 1 { n = substr($2, length(pre) + 1) + 0; if (n > max) max = n }
    END { print pre (max + 1) }'
}

TAB="$(printf '\t')"

# records with sort keys in front: state rank, then epic/number/type. Use cut -f3- to drop them.
keyed_records() {
  records | awk -F'\t' -v OFS='\t' '
    BEGIN { split("backlog refined in-progress in-review completed", s, " "); for (i in s) rank[s[i]] = i }
    { match($2, /[0-9]+/); en = substr($2, RSTART, RLENGTH); rest = substr($2, RSTART + RLENGTH); match(rest, /[0-9]+/); mn = substr(rest, RSTART, RLENGTH)
      print rank[$1], sprintf("%06d%06d%s", en, mn, $4), $0 }'
}

gen_open_tables() { # sorted open records on stdin (cut to records), EPICS.md as arg
  awk -F'\t' '
    FNR == NR { if ($0 ~ /^## E[0-9]+ /) { split($0, a, " "); e = a[2]; order[++n] = e; title[e] = $0 } ; next }
    $1 == "completed" { next }
    {
      id = "[" $2 "](" $10 ")"; d = $8; gsub(/,/, ", ", d)
      rows[$3] = rows[$3] "| " id " | " $9 " | " $1 " | " $7 " | " $5 " | " $6 " | " d " |\n"
    }
    END {
      for (i = 1; i <= n; i++) if (rows[order[i]] != "") {
        printf "\n%s\n\n| ID | Title | State | Status | P | Size | Depends on |\n|---|---|---|---|---|---|---|\n%s", title[order[i]], rows[order[i]]
      }
    }' "$1" -
}

design_status() { awk '/^---$/ { n++; if (n == 2) exit; next } n == 1 && /^status:/ { sub(/^status:[ ]*/, ""); sub(/[ \t]+#.*/, ""); print; exit }' "$1"; }

gen_design_table() { # <design path>: items pointing at it, ID order, links relative to design/
  keyed_records | sort -t "$TAB" -k2,2 | cut -f3- | awk -F'\t' -v d="$1" '
    BEGIN { print "| ID | Title | State |"; print "|---|---|---|" }
    $11 == d { printf "| [%s](../%s) | %s | %s |\n", $2, $10, $9, $1 }'
}

gen_index() { # EPICS.md is read from the cwd
  local f s st
  echo '<!-- generated by wi index, do not edit -->'
  echo '# Index'; echo
  gen_needs_you
  keyed_records | sort -t "$TAB" -k1,1n -k2,2 | cut -f3- | gen_open_tables EPICS.md
  echo; echo '## Designs'; echo
  echo '| Design | Status | Items |'; echo '|---|---|---|'
  for f in design/*.md; do
    [[ -e "$f" ]] || continue
    st="$(design_status "$f")"
    records | awk -F'\t' -v d="$f" -v name="$(basename "$f")" -v st="$st" '
      $11 == d { total++; if ($1 != "completed") open++ }
      END { printf "| [%s](%s) | %s | %d/%d |\n", name, d, st, open, total }'
  done
  if grep -qE '^\| *D[0-9]+ ' DECISIONS.md 2>/dev/null; then
    echo; echo '## Recent decisions'; echo
    echo '| ID | Date | Decision | Design | Supersedes |'; echo '|---|---|---|---|---|'
    grep -E '^\| *D[0-9]+ ' DECISIONS.md | tail -10 | awk '{ l[NR] = $0 } END { for (i = NR; i >= 1; i--) print l[i] }'
  fi
  echo; printf '## Counts: '
  for s in $STATES; do records | awk -F'\t' -v s="$s" '$1 == s { n++ } END { printf "%s %d", s, n }'; [[ $s == completed ]] || printf ' · '; done
  echo
}

has_markers() { grep -qx '<!-- wi:items -->' "$1" && grep -qx '<!-- /wi:items -->' "$1"; }

gen_design_file() { # <design path>
  local t; t="$(mktemp)"; gen_design_table "$1" > "$t"
  awk -v t="$t" '
    /^<!-- wi:items -->$/ { print; while ((getline line < t) > 0) print line; skip = 1; next }
    /^<!-- \/wi:items -->$/ { skip = 0 }
    !skip { print }' "$1"
  rm -f "$t"
}

gen_all() { # <outdir>: candidate INDEX.md and marked designs
  local f
  mkdir -p "$1/design"
  gen_index > "$1/INDEX.md"
  for f in design/*.md; do
    [[ -e "$f" ]] && has_markers "$f" && gen_design_file "$f" > "$1/$f"
  done
  return 0
}

cmd_index() {
  local tmp f; tmp="$(mktemp -d)"; gen_all "$tmp"
  cp "$tmp/INDEX.md" INDEX.md
  for f in "$tmp"/design/*.md; do [[ -e "$f" ]] && cp "$f" "design/$(basename "$f")"; done
  rm -rf "$tmp"
  return 0
}

stale_output() { # <tmp> -> 0 when INDEX.md and design blocks match
  local f
  gen_all "$1"
  { [[ ! -f INDEX.md ]] || cmp -s INDEX.md "$1/INDEX.md"; } || return 1
  for f in "$1"/design/*.md; do
    [[ -e "$f" ]] && ! cmp -s "$f" "design/$(basename "$f")" && return 1
  done
  return 0
}

cmd_validate() {
  local epics rc=0 tmp; epics="$(grep -o '^## E[0-9]*' EPICS.md | sed 's/## //' | tr '\n' ' ' || true)"
  records | awk -F'\t' -v epics="$epics" '
    function bad_(msg) { print msg; bad = 1 }
    BEGIN {
      split(epics, e, " "); for (i in e) epic[e[i]] = 1
      allowed["backlog"] = " backlog "; allowed["refined"] = " refined draft blocked "
      allowed["in-progress"] = " in-progress blocked needs-attention "
      allowed["in-review"] = " in-review needs-attention "; allowed["completed"] = " completed dropped "
    }
    { count[$2]++; where[$2] = where[$2] " " $1; st[$2] = $1; deps[$2] = $8 }
    $2 !~ /^E[0-9]+-[FB][0-9]+$/ { bad_("bad id " $2 " in " $10) }
    $4 != "" && $2 ~ /^E[0-9]+-[FB][0-9]+$/ && $4 != substr($2, index($2, "-") + 1, 1) { bad_($10 ": type " $4 " does not match id " $2) }
    $5 != "" && $5 !~ /^P[1-5]$/ { bad_($10 ": bad priority " $5) }
    $13 != "" && $13 !~ /^(yes|no)$/ { bad_($10 ": bad auto " $13) }
    $6 != "" && $6 !~ /^(XS|S|M|L|XL|XXL)$/ { bad_($10 ": bad size " $6) }
    $2 == "" || $9 == "" || ($1 != "completed" && $4 == "") { bad_("missing id/title/type in " $1 ": " $2) }
    index(allowed[$1], " " $7 " ") == 0 { bad_($10 ": status " $7 " does not fit folder " $1) }
    { slug = $10; sub(/^[^\/]*\//, "", slug); if (index(slug, tolower($2) "-") != 1) bad_($10 ": slug must start with " tolower($2) "-") }
    $11 != "" && $11 != "—" && system("test -f \"" $11 "\"") != 0 { bad_($10 ": design file not found: " $11) }
    !($3 in epic) { bad_($10 ": epic " $3 " not in EPICS.md") }
    END {
      for (id in count) if (count[id] > 1) bad_("duplicate " id ":" where[id])
      for (id in deps) { n = split(deps[id], d, ","); for (i = 1; i <= n; i++) if (d[i] != "" && !(d[i] in st)) bad_(id ": unknown dependency " d[i]) }
      exit bad
    }' || rc=1
  tmp="$(mktemp -d)"
  stale_output "$tmp" || { echo "stale: run wi index"; rc=1; }
  rm -rf "$tmp"
  [[ $rc -eq 0 ]] && echo "ok"
  return $rc
}

cmd_stale() { # [days]: open items not reviewed for N days
  local days="${1:-60}" cutoff
  cutoff="$(date -d "-$days days" +%F 2>/dev/null || date -v-"$days"d +%F)"
  records | awk -F'\t' -v cutoff="$cutoff" -v open="$OPEN_STATES" '
    BEGIN { split(open, o, " "); for (i in o) isopen[o[i]] = 1 }
    isopen[$1] && ($12 == "" || $12 < cutoff) { printf "%-11s %-8s %s  %s\n", $1, $2, ($12 == "" ? "never" : $12), $9 }'
}

case "${1:-list}" in
  list) cmd_list "${2:-}" ;;
  next) cmd_next "${2:-}" ;;
  inbox) cmd_inbox ;;
  nextid) cmd_nextid "${2:-}" "${3:-}" ;;
  index) cmd_index ;;
  validate) cmd_validate ;;
  stale) cmd_stale "${2:-60}" ;;
  *) echo "usage: wi list [state] | next [--auto] | inbox | nextid <E<n>> <F|B> | index | validate | stale [days]" >&2; exit 2 ;;
esac
